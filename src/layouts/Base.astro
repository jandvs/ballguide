---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description } = Astro.props;
const noindex = Astro.props.noindex || import.meta.env.PUBLIC_NOINDEX === "true";
const navLinks = [
  { href: "/bowling-balls-beginners", label: "Balls for Beginners" },
  { href: "/bowling-balls-house-shots", label: "Balls for House Shots" },
  { href: "/bowling-balls-sport-shots", label: "Balls for Sport Shots" },
  { href: "/bowling-shoes-mens", label: "Men's Shoes" },
  { href: "/bowling-shoes-womens", label: "Women's Shoes" },
  { href: "/about", label: "About" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <header class="site-header">
      <div class="masthead">
        <a href="/" class="brand">Ballguide</a>
        <p class="tagline">Top 10 bowling gear guides with lane-match strategy</p>
      </div>
      <nav class="top-nav" aria-label="Primary">
        {
          navLinks.map((link) => (
            <a href={link.href} class="nav-link">{link.label}</a>
          ))
        }
      </nav>
    </header>
    <button
      class="floating-menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="floating-menu-panel"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav id="floating-menu-panel" class="floating-menu-panel" aria-label="Floating primary" hidden>
      {
        navLinks.map((link) => (
          <a href={link.href} class="floating-nav-link">{link.label}</a>
        ))
      }
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Ballguide is reader-supported. Some links are affiliate links, which
        means I may earn a commission if you buy through them, at no extra cost
        to you. I'm not affiliated with any of the brands covered here.
      </p>
    </footer>
    <script>
      (() => {
        const topNav = document.querySelector(".top-nav");
        const toggle = document.querySelector(".floating-menu-toggle");
        const panel = document.querySelector(".floating-menu-panel");

        if (!topNav || !toggle || !panel) {
          return;
        }

        const setOpen = (open) => {
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
          panel.hidden = !open;
        };

        setOpen(false);

        toggle.addEventListener("click", () => {
          const isOpen = toggle.getAttribute("aria-expanded") === "true";
          setOpen(!isOpen);
        });

        panel.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setOpen(false));
        });

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) {
            return;
          }
          if (!panel.hidden && !panel.contains(event.target) && !toggle.contains(event.target)) {
            setOpen(false);
          }
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            setOpen(false);
          }
        });

        const setFloatingVisible = (visible) => {
          document.body.classList.toggle("show-floating-menu", visible);
          if (!visible) {
            setOpen(false);
          }
        };

        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              const [entry] = entries;
              setFloatingVisible(!entry.isIntersecting);
            },
            { threshold: 0 }
          );
          observer.observe(topNav);
        } else {
          const onScroll = () => {
            const rect = topNav.getBoundingClientRect();
            setFloatingVisible(rect.bottom < 0);
          };
          onScroll();
          window.addEventListener("scroll", onScroll, { passive: true });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f6f7f5;
    --surface: #ffffff;
    --ink: #18212b;
    --muted: #5b6672;
    --line: #d9ddd8;
    --pin-red: #b3261e;
    --lane: #c8a26b;
    --serif: Rockwell, "Roboto Slab", Georgia, serif;
    --sans: "Segoe UI", "Avenir Next", "Helvetica Neue", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  h1,
  h2,
  h3 {
    font-family: var(--serif);
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }

  h1 {
    font-size: clamp(1.9rem, 5vw, 2.75rem);
  }

  h2 {
    font-size: 1.5rem;
  }

  h3 {
    font-size: 1.05rem;
  }

  a {
    color: var(--ink);
    text-decoration-color: var(--pin-red);
    text-underline-offset: 0.18em;
  }

  a:focus-visible,
  .buy:focus-visible {
    outline: 3px solid var(--pin-red);
    outline-offset: 3px;
  }

  .site-header {
    border-bottom: 4px solid var(--pin-red);
    background:
      linear-gradient(135deg, #ffffff 0%, #f8f4ec 60%, #f2efe8 100%);
    padding: 1rem 1.25rem 1.1rem;
    display: grid;
    gap: 0.85rem;
  }

  .masthead {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .tagline {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .top-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .brand {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.85);
    padding: 0.33rem 0.55rem;
    border-radius: 999px;
  }

  .nav-link:hover {
    border-color: var(--pin-red);
    color: var(--pin-red);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    padding: 1.5rem 1.25rem 3rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .site-footer p {
    max-width: 44rem;
    margin: 0 auto;
  }

  .floating-menu-toggle {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.96);
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.25rem;
    z-index: 1000;
    box-shadow: 0 10px 24px rgba(24, 33, 43, 0.14);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .floating-menu-toggle span {
    width: 1.2rem;
    height: 2px;
    background: var(--ink);
    display: block;
  }

  .floating-menu-panel {
    position: fixed;
    top: 3.6rem;
    left: 0.75rem;
    width: min(18rem, calc(100vw - 1.5rem));
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    padding: 0.55rem;
    box-shadow: 0 14px 30px rgba(24, 33, 43, 0.16);
    z-index: 1000;
  }

  .floating-nav-link {
    display: block;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    border-radius: 0.4rem;
    padding: 0.45rem 0.5rem;
  }

  .floating-nav-link:hover {
    background: #f5f7fa;
    color: var(--pin-red);
  }

  body.show-floating-menu .floating-menu-toggle {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 42rem) {
    .tagline {
      width: 100%;
      font-size: 0.86rem;
    }
  }
</style>
