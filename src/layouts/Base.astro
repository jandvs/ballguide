---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description } = Astro.props;
const noindex = Astro.props.noindex || import.meta.env.PUBLIC_NOINDEX === "true";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <header class="site-header">
      <div class="masthead">
        <a href="/" class="brand">Ballguide</a>
        <p class="tagline">Top 10 bowling gear guides with lane-match strategy</p>
      </div>
      <nav class="top-nav" aria-label="Primary">
        <a href="/bowling-balls-beginners" class="nav-link">Balls for Beginners</a>
        <a href="/bowling-balls-house-shots" class="nav-link">Balls for House Shots</a>
        <a href="/bowling-balls-sport-shots" class="nav-link">Balls for Sport Shots</a>
        <a href="/bowling-shoes-mens" class="nav-link">Men's Shoes</a>
        <a href="/bowling-shoes-womens" class="nav-link">Women's Shoes</a>
        <a href="/about" class="nav-link">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Ballguide is reader-supported. Some links are affiliate links, which
        means I may earn a commission if you buy through them, at no extra cost
        to you. I'm not affiliated with any of the brands covered here.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f6f7f5;
    --surface: #ffffff;
    --ink: #18212b;
    --muted: #5b6672;
    --line: #d9ddd8;
    --pin-red: #b3261e;
    --lane: #c8a26b;
    --serif: Rockwell, "Roboto Slab", Georgia, serif;
    --sans: "Segoe UI", "Avenir Next", "Helvetica Neue", sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  h1,
  h2,
  h3 {
    font-family: var(--serif);
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }

  h1 {
    font-size: clamp(1.9rem, 5vw, 2.75rem);
  }

  h2 {
    font-size: 1.5rem;
  }

  h3 {
    font-size: 1.05rem;
  }

  a {
    color: var(--ink);
    text-decoration-color: var(--pin-red);
    text-underline-offset: 0.18em;
  }

  a:focus-visible,
  .buy:focus-visible {
    outline: 3px solid var(--pin-red);
    outline-offset: 3px;
  }

  .site-header {
    border-bottom: 4px solid var(--pin-red);
    background:
      linear-gradient(135deg, #ffffff 0%, #f8f4ec 60%, #f2efe8 100%);
    padding: 1rem 1.25rem 1.1rem;
    display: grid;
    gap: 0.85rem;
  }

  .masthead {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .tagline {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .top-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .brand {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.85);
    padding: 0.33rem 0.55rem;
    border-radius: 999px;
  }

  .nav-link:hover {
    border-color: var(--pin-red);
    color: var(--pin-red);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    padding: 1.5rem 1.25rem 3rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .site-footer p {
    max-width: 44rem;
    margin: 0 auto;
  }

  @media (max-width: 42rem) {
    .tagline {
      width: 100%;
      font-size: 0.86rem;
    }
  }
</style>
