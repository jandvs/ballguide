---
import Base from "../layouts/Base.astro";

type Product = {
  id: string;
  rank: number;
  name: string;
  brand: string;
  category: string;
  priceRange: string;
  releaseYear: number;
  bestFor: string;
  laneMatch: string;
  bowlerMatch: string;
  layoutTip: string;
  coverstock?: string;
  core?: string;
  weightBlock?: string;
  testedByMe?: boolean;
  summary: string;
  pros: string[];
  cons: string[];
  affiliateUrl: string;
};

interface Props {
  title: string;
  description: string;
  heading: string;
  intro: string;
  updated: string;
  products: Product[];
  noindex?: boolean;
}

const { title, description, heading, intro, updated, products, noindex } =
  Astro.props;

// Flip to true only after Amazon Associates approves the account.
const amazonAssociate = false;

const rankedProducts = [...products].sort((a, b) => a.rank - b.rank);
---

<Base title={title} description={description} noindex={noindex}>
  <article class="wrap">
    <h1>{heading}</h1>
    <p class="intro">{intro}</p>
    <p class="disclosure">
      Some links on this page are affiliate links. If you buy through them, I
      may earn a commission at no extra cost to you.
      {amazonAssociate && " As an Amazon Associate I earn from qualifying purchases."}
    </p>
    <p class="updated">Updated {updated}</p>

    <section aria-labelledby="compare">
      <h2 id="compare">Side by side</h2>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Rank</th>
              <th scope="col">Product</th>
              <th scope="col">Best for</th>
              <th scope="col">Lane match</th>
              <th scope="col">Price</th>
            </tr>
          </thead>
          <tbody>
            {
              rankedProducts.map((p) => (
                <tr>
                  <td>{p.rank}</td>
                  <th scope="row">
                    <a href={`#${p.id}`}>{p.name}</a>
                  </th>
                  <td>{p.bestFor}</td>
                  <td>{p.laneMatch}</td>
                  <td>{p.priceRange}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {
      rankedProducts.map((p) => (
        <section class:list={["product", { tested: p.testedByMe }]} id={p.id}>
          <header>
            <p class="rank">#{p.rank}</p>
            <h2>{p.name} <span class="brand">by {p.brand}</span></h2>
            <p class="badge">
              {p.testedByMe
                ? "Tested by me"
                : "Researched from verified reviewer consensus"}
            </p>
          </header>

          <p class="summary">{p.summary}</p>

          <dl class="specs">
            <div>
              <dt>Category</dt>
              <dd>{p.category}</dd>
            </div>
            <div>
              <dt>Best for</dt>
              <dd>{p.bestFor}</dd>
            </div>
            <div>
              <dt>Lane match</dt>
              <dd>{p.laneMatch}</dd>
            </div>
            <div>
              <dt>Bowler match</dt>
              <dd>{p.bowlerMatch}</dd>
            </div>
            <div>
              <dt>Layout tip</dt>
              <dd>{p.layoutTip}</dd>
            </div>
            <div>
              <dt>Price range</dt>
              <dd>{p.priceRange}</dd>
            </div>
            <div>
              <dt>Release year</dt>
              <dd>{p.releaseYear}</dd>
            </div>
          </dl>

          {(p.core || p.coverstock || p.weightBlock) && (
            <dl class="tech-specs">
              {p.core && (
                <div>
                  <dt>Core</dt>
                  <dd>{p.core}</dd>
                </div>
              )}
              {p.coverstock && (
                <div>
                  <dt>Coverstock</dt>
                  <dd>{p.coverstock}</dd>
                </div>
              )}
              {p.weightBlock && (
                <div>
                  <dt>Weight block</dt>
                  <dd>{p.weightBlock}</dd>
                </div>
              )}
            </dl>
          )}

          <div class="pros-cons">
            <section>
              <h3>Pros</h3>
              <ul>
                {p.pros.map((pro) => (
                  <li>{pro}</li>
                ))}
              </ul>
            </section>
            <section>
              <h3>Cons</h3>
              <ul>
                {p.cons.map((con) => (
                  <li>{con}</li>
                ))}
              </ul>
            </section>
          </div>

          {p.affiliateUrl && (
            <a
              class="buy"
              href={p.affiliateUrl}
              rel="sponsored nofollow noopener"
              target="_blank"
            >
              Check current price
            </a>
          )}
        </section>
      ))
    }
  </article>
</Base>

<style>
  .wrap {
    max-width: 62rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 0;
  }

  .intro {
    max-width: 44rem;
    font-size: 1.15rem;
  }

  .disclosure,
  .updated {
    max-width: 44rem;
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0.5rem 0;
  }

  section[aria-labelledby="compare"] {
    margin-top: 2rem;
  }

  .table-scroll {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
  }

  table {
    width: 100%;
    min-width: 46rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  thead th {
    background: var(--paper);
    font-weight: 600;
  }

  tbody th {
    font-weight: 600;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  .product {
    margin-top: 2.5rem;
    padding: 1.25rem 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 6px solid var(--line);
    border-radius: 0.5rem;
    max-width: 48rem;
  }

  .product.tested {
    border-left-color: var(--pin-red);
  }

  .rank {
    color: var(--muted);
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .brand {
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 400;
  }

  .badge {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .product.tested .badge {
    color: var(--pin-red);
    font-weight: 600;
  }

  .summary {
    margin: 0 0 0.75rem;
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin: 0 0 1rem;
  }

  .specs div {
    border-top: 2px solid var(--lane);
    padding-top: 0.35rem;
  }

  dt {
    color: var(--muted);
    font-size: 0.85rem;
  }

  dd {
    margin: 0;
    font-weight: 600;
  }

  .take,
  .pros-cons {
    margin-top: 1rem;
  }

  .tech-specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .tech-specs div {
    border-top: 1px solid var(--line);
    padding-top: 0.5rem;
  }

  .pros-cons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .pros-cons section {
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 0.85rem;
    border-radius: 0.35rem;
  }

  .pros-cons ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .buy {
    display: inline-block;
    margin-top: 1.25rem;
    padding: 0.7rem 1.1rem;
    background: var(--pin-red);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
</style>
